{
  // StateCheckAndPreprocess — minimal realistic input
  //    Two scenarios shown:
  //      Scenario A: MP4 / any non-WAV → needs_conversion=true
  //      Scenario B: 48kHz mono WAV   → needs_conversion=false (fast-path)
  //
  //    Use Scenario A as the default test input.
  "operation": "StateCheckAndPreprocess",
  "uuid": "8f3a1c2d-0001-0000-0000-000000000000",

  "input": {
    "s3uri": "s3://<your-ingest-bucket>/uploads/interview.mp4", // Scenario A: MP4 needs conversion
    // "s3uri": "s3://<your-ingest-bucket>/uploads/mono48k.wav"   // Scenario B: compatible WAV, bypass

    // input_config — fully optional; all fields have defaults (see lib/input_schema.py)
    "input_config": {
      "model_id": "deepfilternet3", // Fixed value. Informative only

      "fixed_chunk_size_secs": 360 // Configurable chunk size per iterator; aligned to the
                                   // nearest 10 s multiple (DFN3's internal window). Default 6 mins
    }
  },

  "output": {
    "s3uri": "s3://<your-proxy-bucket>/path/to/output/prefix", // mandatory

    // output_config — fully optional; all fields have defaults
    "output_config": {
      // Enhanced WAV output sample rate
      "output_resampl_freq": 16000, // 8000, 16000, 32000, 44100, 48000, 96000

      // Cap on noise attenuation in dB (gentler enhancement);
      // null = model default (full suppression)
      "atten_lim_db": null
    }
  },

  "data": {}
}
